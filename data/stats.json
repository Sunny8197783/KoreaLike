  "quantize": {
    "rule": "phase_carry",
    "doc": "05 3.2.2a (single source of truth)",
    "cd": "max(min_period, base_cd * max(floor, stat_jangdan)); floor 0.40, 0.25 during sinmyeong_oreum",
    "on_acquire": "ideal_t = t (fire on next grid tick)",
    "on_grid_tick": "if t+eps >= ideal_t and t >= last_fire_t + g: fire; last_fire_t = t; ideal_t += cd; if t - ideal_t > g: ideal_t = t + cd",
    "on_cd_change": "ideal_t = last_fire_t + (ideal_t - last_fire_t) * cd_new / cd_old",
    "mean_interval": "max(cd, g)",
    "min_interval_grids": 1,
    "grid_source": "combat_core.jangdan.geori[].grid_div (= weapons.json geori_grid); downbeat weapons (wpn_janggu, evo_hapjangdan) use 1 beat",
    "cr1_position": "canon v1.2 D-18 approved CR1: 3-bun-bak jangdan (jungjungmori, jajinmori) use 1/3 beat, 2-bun-bak 1/2 beat; DPS-neutral under phase_carry",
    "canon_label": "잔여 이월(위상 이월) — canon v1.2 D-21/C-06 (phase_carry is the canonical algorithm)",
    "max_fires_per_sec_per_weapon": 6.7,
    "projectile_check": "6 weapons * 6.7/s * (1+10) * 1.0s ~= 440 < soft cap 600; per-weapon max_active binds first (~200)"
  },
