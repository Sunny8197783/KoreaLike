{
  "_meta": {
    "schema": "soulpath.passives.v1",
    "doc": "design/05-stats-passives.md v0.10 (9장, 10장, 20장 리뷰 대응 로그)",
    "canon": "design/01-concept-and-canon.md 4.4",
    "canon_version": "v1.2",
    "notes": [
      "levels[] 값은 해당 레벨의 누적 총합이다(증분 아님).",
      "op: flat = 기본치에 고정 가산, add_pct = 가산 % 버킷(0.08 = +8%).",
      "lv5_completion은 [NEW] 섹션 초안 효과다. 캐논 Lv당 값은 바꾸지 않았다.",
      "base_weight는 점지 항목 가중치(10.4). 실제 가중치 = base_weight × luck_factor(rarity) × owned_mult × evo_mult. (focus_mult는 보유 무구 전용이라 패시브에는 없다.) 점지 규칙 전체의 정본은 stats.json jeomji."
    ],
    "rules": {
      "slots": 6,
      "max_level": 5,
      "evolution_requires": "pair weapon Lv8 + this passive Lv>=1 + box opened (box_gilhyung or box_neokham)",
      "passive_kept_after_evolution": true,
      "rarity_base_weight": { "common": 100, "uncommon": 60, "rare": 30 },
      "luck_exponent": { "common": 0.0, "uncommon": 0.75, "rare": 1.5 },
      "luck_L_clamp": [0.5, 3.0],
      "owned_mult": 1.3,
      "evo_mult_pair_passive": 1.5,
      "evo_mult_pair_passive_weapon_lv8": 2.5,
      "evo_mult_pair_weapon": 1.3
    }
  },
