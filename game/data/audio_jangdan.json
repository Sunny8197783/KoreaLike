  "quantize": {
    "rule": "무구 발동 시각은 항상 현재 무구 그리드 틱 위. 유일한 규칙 = 위상 이월(05-stats-passives 3.2.2a): 이상 발동 시각 ideal_t에 cd를 더해 평균 주기 = cd",
    "mode": "phase_carry",
    "canon_term": "잔여 이월(위상 이월) — 캐논 v1.2 D-21 정본 알고리즘 phase_carry(05 §3.2.2a). combat_core.json quantize_rule = \"phase_carry\"",
    "modes_supported": [
      "phase_carry"
    ],
    "phase_carry": {
      "state": [
        "ideal_t (s, beat_tick 시계)",
        "last_fire_t (s)"
      ],
      "cd": "max(min_period, cd_base * max(F, stat_jangdan))",
      "fire_when": "t + eps >= ideal_t and t >= last_fire_t + g",
      "after_fire": "last_fire_t = t; ideal_t += cd; if t - ideal_t > g: ideal_t = t + cd",
      "eps_ms": 1.0,
      "min_interval": "1 grid (g)",
      "on_bpm_change": "ideal_t 유지(초 단위), 다음 틱부터 새 g",
      "result": "개별 간격 = g의 정수배, 장기 평균 간격 = cd"
    },
    "rejected": {
      "ceil_to_next_grid": "폐기: P = ceil(C/g)*g. DPS 최대 약 -25%, 작은 쿨 감소가 실효 0(죽은 픽). (02·combat_core.json v1.2 D-21 정정 완료)",
      "acc_carry": "폐기: 04 2.4.2의 acc 이월(carry_over, acc 상한 P+g). 05 위상 이월로 대체(캐논 v1.2 D-21)"
    },
