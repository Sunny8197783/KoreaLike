  "beats": [
    {
      "id": "B01",
      "priority": 100,
      "once": true,
      "kind": "main",
      "location": "hub_sindang",
      "requires": [
        "flag.first_hub_visit"
      ],
      "condition_text": "프로필 첫 로비 진입",
      "summary": "서기 귀신 등장. 대맺힘 설명. 넋기록 = 장부 복원 의뢰",
      "lines": [
        {
          "speaker": "npc_myeongbu_seogi",
          "key": "beat.B01.1",
          "ko": "실례하오! 명부 서기올시다. 문이 열려 있기에."
        },
        {
          "speaker": "char_mansin",
          "key": "beat.B01.2",
          "ko": "…귀신이 노크도 해?"
        },
        {
          "speaker": "npc_myeongbu_seogi",
          "key": "beat.B01.3",
          "ko": "기록에 의하면 이 신당은 은실 만신 소관. 그분이 가신 뒤 넋길이 꽉 막혔소. 우리는 이걸 대맺힘이라 적소."
        },
        {
          "speaker": "npc_myeongbu_seogi",
          "key": "beat.B01.4",
          "ko": "넋이 안 넘어오니 장부는 엉망이고, 나는 장부 한 묶음 들고 도망…아니, 출장 왔소."
        },
        {
          "speaker": "npc_myeongbu_seogi",
          "key": "beat.B01.5",
          "ko": "무당께서 넋을 풀어 사연을 들으면, 내가 받아 적겠소. 이름이 장부에 돌아오면 넋도 길을 찾소."
        },
        {
          "speaker": "char_mansin",
          "key": "beat.B01.6",
          "ko": "어머니 이름도 거기 있어?"
        },
        {
          "speaker": "npc_myeongbu_seogi",
          "key": "beat.B01.7",
          "ko": "…찾는 중이오."
        }
      ]
    },
    {
      "id": "B02",
      "priority": 100,
      "once": true,
      "kind": "main",
      "location": "hub_daejanggan",
      "requires": [
        "stats.deaths >= 1"
      ],
      "condition_text": "첫 쓰러짐(사인 무관) 후 로비",
      "summary": "\"쓰러졌다고 굿이 끝나냐.\" 은실도 처음엔 자주 쓰러졌다는 이야기",
      "lines": [
        {
          "speaker": "npc_soeme",
          "key": "beat.B02.1",
          "ko": "쓰러졌냐."
        },
        {
          "speaker": "char_mansin",
          "key": "beat.B02.2",
          "ko": "…네."
        },
        {
          "speaker": "npc_soeme",
          "key": "beat.B02.3",
          "ko": "은실이도 처음 십 년은 굿판에서 자주 뻗었다. 그래도 다음 날이면 칼 갈러 왔지."
        },
        {
          "speaker": "npc_soeme",
          "key": "beat.B02.4",
          "ko": "쓰러졌다고 굿이 끝나냐. 칼 줘 봐라. 벼려 놓으마."
        }
      ]
    },
