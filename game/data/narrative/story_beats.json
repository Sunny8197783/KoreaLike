    {
      "id": "B05",
      "priority": 100,
      "once": true,
      "kind": "main",
      "location": "hub_sindang",
      "requires": [
        "unlocked.char_baksu"
      ],
      "condition_text": "`char_baksu` 해금",
      "summary": "무진 합류. 해원·퇴치 첫 논쟁",
      "lines": [
        {
          "speaker": "char_baksu",
          "key": "beat.B05.1",
          "ko": "막내. 귀신 하나하나 달래다가 네가 다치면 그게 굿이냐."
        },
        {
          "speaker": "char_mansin",
          "key": "beat.B05.2",
          "ko": "오빠는 다 쳐내고 나면 살이 남잖아. 그거 다 돌아와."
        },
        {
          "speaker": "char_baksu",
          "key": "beat.B05.3",
          "ko": "돌아오면 또 물리면 된다. 불 속에선 빨리 끌어내는 게 사람 살리는 거였다."
        },
        {
          "speaker": "char_mansin",
          "key": "beat.B05.4",
          "ko": "여긴 불 속 아니야."
        },
        {
          "speaker": "char_baksu",
          "key": "beat.B05.5",
          "ko": "굿판도 불 속이다. 다만 타는 게 한일 뿐."
        },
        {
          "speaker": "char_baksu",
          "key": "beat.B05.6",
          "ko": "…어머니라면 뭐라고 했을까."
        },
        {
          "speaker": "char_mansin",
          "key": "beat.B05.7",
          "ko": "\"둘 다 해라.\""
        },
        {
          "speaker": "char_baksu",
          "key": "beat.B05.8",
          "ko": "(짧게 웃는다) 그 양반답다."
        }
      ]
    },
