  "lines": [
    {
      "key": "gs.sansin.trial_announce.1",
      "speaker": "deity_sansin",
      "face": "common",
      "trigger": "gs_trial_announce",
      "ko": "산이 운다…",
      "en": "The mountain weeps…"
    },
    {
      "key": "gs.sansin.trial_announce.2",
      "speaker": "deity_sansin",
      "face": "common",
      "trigger": "gs_trial_announce",
      "ko": "솔바람이 멎었네. 범이 내려오네.",
      "en": "The pine wind stills. The tiger descends."
    },
    {
      "key": "gs.sansin.trial_enter.1",
      "speaker": "deity_sansin",
      "face": "common",
      "trigger": "gs_trial_enter",
      "ko": "내 앞에 섰는가. 어디 보세.",
      "en": "You stand before me. Let me look at you."
    },
    {
      "key": "gs.sansin__wieom.trial_wieom.1",
      "speaker": "deity_sansin",
      "face": "wieom",
      "trigger": "gs_trial_wieom",
      "ko": "범의 발톱을 빌려주마. 베어라!",
      "en": "Take the tiger's claws. Cut!"
    },
    {
      "key": "gs.sansin__wieom.trial_wieom.2",
      "speaker": "deity_sansin",
      "face": "wieom",
      "trigger": "gs_trial_wieom",
      "ko": "기세가 좋다. 산이 네 편이다.",
      "en": "Fierce. The mountain stands with you."
    },
    {
      "key": "gs.sansin__gaho.trial_gaho.1",
      "speaker": "deity_sansin",
      "face": "gaho",
      "trigger": "gs_trial_gaho",
      "ko": "길 잃은 것들은 내가 업고 가세.",
      "en": "The lost ones, I'll carry on my back."
    },
    {
      "key": "gs.sansin__gaho.trial_gaho.2",
      "speaker": "deity_sansin",
      "face": "gaho",
      "trigger": "gs_trial_gaho",
      "ko": "산길은 자네가 닦게. 범은 내가 맡지.",
      "en": "You clear the trail. I'll mind the tiger."
    },
    {
      "key": "gs.sansin__wieom.ring_big.1",
      "speaker": "deity_sansin",
      "face": "wieom",
      "trigger": "gs_ring_big",
      "ko": "한 번에 쓸었구나! 범도 놀라겠다.",
      "en": "One sweep! Even the tiger is startled."
    },
    {
      "key": "gs.sansin__gaho.ring_big.1",
      "speaker": "deity_sansin",
      "face": "gaho",
      "trigger": "gs_ring_big",
      "ko": "옳지, 산길 닦듯 닦는구먼.",
      "en": "That's it—like clearing a mountain trail."
    },
    {
      "key": "gs.sansin.elite_haewon.1",
      "speaker": "deity_sansin",
      "face": "common",
      "trigger": "gs_elite_haewon",
      "ko": "저 녀석도 산에 묻은 사연이 있었지.",
      "en": "That one had a story buried in the hills."
    },
    {
      "key": "gs.sansin__wieom.elite_toechi.1",
      "speaker": "deity_sansin",
      "face": "wieom",
      "trigger": "gs_elite_toechi",
      "ko": "물러가라! 산신 앞이다!",
      "en": "Begone! You stand before the Mountain God!"
    },
    {
      "key": "gs.sansin.low_hp.1",
      "speaker": "deity_sansin",
      "face": "common",
      "trigger": "gs_low_hp",
      "ko": "숨 고르게. 산은 어디 안 가네.",
      "en": "Catch your breath. The mountain will wait."
    },
    {
      "key": "gs.sansin.salgi_warn.1",
      "speaker": "deity_sansin",
      "face": "common",
      "trigger": "gs_salgi_warn",
      "ko": "골짜기에 살이 고였네. 곧 일어서겠어.",
      "en": "Blight pools in the valley. It will rise."
    },
    {
      "key": "gs.sansin.eodukssini_first.1",
      "speaker": "deity_sansin",
      "face": "common",
      "trigger": "gs_eodukssini_first",
      "ko": "어둠은 쳐다볼수록 크네. 등을 보이게.",
      "en": "Darkness grows when watched. Turn your back."
    },
    {
      "key": "gs.sansin.domain_haewon.1",
      "speaker": "deity_sansin",
      "face": "common",
      "trigger": "gs_domain_haewon",
      "ko": "범에게 물려 간 넋이구나… 미안하네.",
      "en": "Taken by a tiger… I'm sorry, child."
    },
    {
      "key": "gs.sansin.boss_enter.1",
      "speaker": "deity_sansin",
      "face": "common",
      "trigger": "gs_boss_enter",
      "ko": "역려가 오셨네. 산처럼 버티게.",
      "en": "A great guest arrives. Stand like a mountain."
    },
    {
      "key": "gs.yongwang.trial_announce.1",
      "speaker": "deity_yongwang",
      "face": "common",
      "trigger": "gs_trial_announce",
      "ko": "물때가 바뀌었소.",
      "en": "The tide has turned."
    },
    {
      "key": "gs.yongwang.trial_announce.2",
      "speaker": "deity_yongwang",
      "face": "common",
      "trigger": "gs_trial_announce",
      "ko": "바다가 숨을 들이쉬오.",
      "en": "The sea draws a long breath."
    },
    {
      "key": "gs.yongwang.trial_enter.1",
      "speaker": "deity_yongwang",
      "face": "common",
      "trigger": "gs_trial_enter",
      "ko": "물가에 선 이여, 무엇을 청하오?",
      "en": "You at the water's edge—what do you ask?"
    },
    {
      "key": "gs.yongwang__wieom.trial_wieom.1",
      "speaker": "deity_yongwang",
      "face": "wieom",
      "trigger": "gs_trial_wieom",
      "ko": "물결이 그대 발을 따를 것이오.",
      "en": "The waves will follow your feet."
    },
    {
      "key": "gs.yongwang__wieom.trial_wieom.2",
      "speaker": "deity_yongwang",
      "face": "wieom",
      "trigger": "gs_trial_wieom",
      "ko": "거센 물결로 쓸어 가시오.",
      "en": "Sweep them away like a heavy swell."
    },
    {
      "key": "gs.yongwang__gaho.trial_gaho.1",
      "speaker": "deity_yongwang",
      "face": "gaho",
      "trigger": "gs_trial_gaho",
      "ko": "물에 든 넋들, 내가 건져 주리다.",
      "en": "The souls in the water—I'll draw them up."
    },
    {
      "key": "gs.yongwang__gaho.trial_gaho.2",
      "speaker": "deity_yongwang",
      "face": "gaho",
      "trigger": "gs_trial_gaho",
      "ko": "맑은 물을 내어 주겠소. 씻겨 보내시오.",
      "en": "Take my clear water. Wash them, then send them."
    },
    {
      "key": "gs.yongwang__wieom.ring_big.1",
      "speaker": "deity_yongwang",
      "face": "wieom",
      "trigger": "gs_ring_big",
      "ko": "해일처럼 덮쳤구려!",
      "en": "Like a tidal wave!"
    },
    {
      "key": "gs.yongwang__gaho.ring_big.1",
      "speaker": "deity_yongwang",
      "face": "gaho",
      "trigger": "gs_ring_big",
      "ko": "밀물처럼 감싸고, 썰물처럼 보내시오.",
      "en": "Embrace like the flood; release like the ebb."
    },
    {
      "key": "gs.yongwang.elite_haewon.1",
      "speaker": "deity_yongwang",
      "face": "common",
      "trigger": "gs_elite_haewon",
      "ko": "깊은 물 밑에도 이름은 남는 법이오.",
      "en": "Even under deep water, a name remains."
    },
    {
      "key": "gs.yongwang.low_hp.1",
      "speaker": "deity_yongwang",
      "face": "common",
      "trigger": "gs_low_hp",
      "ko": "물러나시오. 파도도 물러났다 다시 오오.",
      "en": "Fall back. Even waves retreat, then return."
    },
    {
      "key": "gs.yongwang.salgi_warn.1",
      "speaker": "deity_yongwang",
      "face": "common",
      "trigger": "gs_salgi_warn",
      "ko": "물이 탁해지고 있소. 맑혀야 하오.",
      "en": "The water grows murky. It must be cleared."
    },
    {
      "key": "gs.yongwang.eodukssini_first.1",
      "speaker": "deity_yongwang",
      "face": "common",
      "trigger": "gs_eodukssini_first",
      "ko": "안개 속 그림자는 보지 마오. 지나가오.",
      "en": "Don't stare at shadows in the fog. Walk on."
    },
    {
      "key": "gs.yongwang.domain_haewon.1",
      "speaker": "deity_yongwang",
      "face": "common",
      "trigger": "gs_domain_haewon",
      "ko": "차가웠겠소. 이제 따뜻한 물로 가시오.",
      "en": "It must have been cold. Go now, into warm water."
    },
    {
      "key": "gs.yongwang.box_open.1",
      "speaker": "deity_yongwang",
      "face": "common",
      "trigger": "gs_box_open",
      "ko": "바다는 빈 그물로 돌려보내지 않소.",
      "en": "The sea never sends back an empty net."
    },
    {
      "key": "gs.yongwang.boss_enter.1",
      "speaker": "deity_yongwang",
      "face": "common",
      "trigger": "gs_boss_enter",
      "ko": "큰 물결이 오오. 발을 단단히 딛으시오.",
      "en": "A great wave comes. Plant your feet."
    },
    {
      "key": "gs.chilseong.trial_announce.1",
      "speaker": "deity_chilseong",
      "face": "common",
      "trigger": "gs_trial_announce",
      "ko": "북녘 하늘에 일곱 별이 낮게 떴다.",
      "en": "Seven stars hang low in the north."
    },
    {
      "key": "gs.chilseong.trial_announce.2",
      "speaker": "deity_chilseong",
      "face": "common",
      "trigger": "gs_trial_announce",
      "ko": "명(命)을 셈할 때가 왔다.",
      "en": "The hour has come to count fates."
    },
    {
      "key": "gs.chilseong.trial_enter.1",
      "speaker": "deity_chilseong",
      "face": "common",
      "trigger": "gs_trial_enter",
      "ko": "별을 보러 왔느냐.",
      "en": "Have you come to see the stars?"
    },
    {
      "key": "gs.chilseong__wieom.trial_wieom.1",
      "speaker": "deity_chilseong",
      "face": "wieom",
      "trigger": "gs_trial_wieom",
      "ko": "일곱 별을 쏘아라. 하늘이 셈한다.",
      "en": "Loose the seven stars. Heaven keeps count."
    },
    {
      "key": "gs.chilseong__wieom.trial_wieom.2",
      "speaker": "deity_chilseong",
      "face": "wieom",
      "trigger": "gs_trial_wieom",
      "ko": "별이 떨어지는 곳마다 길이 난다.",
      "en": "Wherever a star falls, a path opens."
    },
    {
      "key": "gs.chilseong__gaho.trial_gaho.1",
      "speaker": "deity_chilseong",
      "face": "gaho",
      "trigger": "gs_trial_gaho",
      "ko": "명줄 하나, 이어 두었다.",
      "en": "I have tied one more thread of life."
    },
    {
      "key": "gs.chilseong__gaho.trial_gaho.2",
      "speaker": "deity_chilseong",
      "face": "gaho",
      "trigger": "gs_trial_gaho",
      "ko": "일곱 별을 이었구나. 네 명도 길어졌다.",
      "en": "You joined the seven. Your fate grows long."
    },
    {
      "key": "gs.chilseong__wieom.ring_big.1",
      "speaker": "deity_chilseong",
      "face": "wieom",
      "trigger": "gs_ring_big",
      "ko": "별자리처럼 맞물렸구나.",
