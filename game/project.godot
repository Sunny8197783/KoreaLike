; Engine configuration file.
; 넋길: 해원굿 — Godot 4.7 / gl_compatibility / 640x360 x3
config_version=5

[application]

config/name="넋길: 해원굿"
config/description="SOULPATH: Untie the Han — 한국 무속 뱀서라이크"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.054902, 0.043137, 0.086275, 1)
boot_splash/show_image=false

[autoload]

Data="*res://autoload/data.gd"
AssetCache="*res://autoload/asset_cache.gd"
Rng="*res://autoload/rng.gd"
Events="*res://autoload/events.gd"
Game="*res://autoload/game.gd"
Beat="*res://autoload/beat.gd"
Juice="*res://autoload/juice.gd"
Audio="*res://autoload/audio.gd"
Save="*res://autoload/save.gd"
DebugTools="*res://autoload/debug_tools.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1

[gui]

theme/custom="res://ui/theme/main_theme.tres"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.054902, 0.043137, 0.086275, 1)
